{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/**/*.py": {
      "includeFiles": "{backend/**,platforms/**,dist/**,requirements.txt,pyproject.toml}",
      "excludeFiles": "{**/node_modules/**,**/.venv/**,**/__pycache__/**,**/tests/**,platforms/crypto/Yaoguai-Crypto.rar,**/*.db,**/*.sqlite,**/*.sqlite3}"
    }
  },
  "redirects": [
    { "source": "/crypto", "destination": "/crypto/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api?route=/api/:path*" },
    { "source": "/network", "destination": "/api?route=/network" },
    { "source": "/network/:path*", "destination": "/api?route=/network/:path*" },
    { "source": "/linux", "destination": "/api?route=/linux" },
    { "source": "/linux/:path*", "destination": "/api?route=/linux/:path*" },
    { "source": "/programming", "destination": "/api?route=/programming" },
    { "source": "/programming/:path*", "destination": "/api?route=/programming/:path*" },
    { "source": "/crypto", "destination": "/api?route=/crypto" },
    { "source": "/crypto/:path*", "destination": "/api?route=/crypto/:path*" },
    { "source": "/admin", "destination": "/api?route=/admin" },
    { "source": "/reset-password", "destination": "/api?route=/reset-password" }
  ]
}
